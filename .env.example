# ------------------------------------------------------------
# João do Carro — variáveis de ambiente
# Copie este arquivo para .env.local e preencha com os seus dados.
# NUNCA envie o arquivo .env.local para o GitHub.
# ------------------------------------------------------------

# URL pública do site (sem barra no final). Usada em SEO, sitemap e Open Graph.
# Local: http://localhost:3000 | Produção: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Nome do bucket do Supabase Storage usado para fotos e logo (padrão: media)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=media
